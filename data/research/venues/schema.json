{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tomoponz/kyoto-osaka-trip-2026/data/research/venues/schema.json",
  "title": "Kyoto Osaka Trip Venue Research",
  "type": "object",
  "required": ["version","slug","name","status","lastResearched","confidence","summary","tripRecommendation","durationProfiles","tips","sources"],
  "properties": {
    "version": {"type":"integer","const":1},
    "slug": {"type":"string","minLength":1},
    "name": {"type":"string","minLength":1},
    "status": {"type":"string","enum":["NOT_STARTED","IN_PROGRESS","RESEARCHED","NEEDS_UPDATE","VERIFIED"]},
    "lastResearched": {"type":["string","null"],"pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "confidence": {"type":"string","enum":["LOW","MEDIUM","HIGH"]},
    "tripFit": {"type":"string","enum":["LOW","MEDIUM","HIGH","VERY_HIGH"]},
    "summary": {"type":"string"},
    "tripRecommendation": {
      "type":"object",
      "required":["recommendedDuration","recommendedArrival","latestDeparture","budgetPerPerson"],
      "properties": {
        "recommendedDuration":{"type":"string"},
        "recommendedArrival":{"type":"string"},
        "latestDeparture":{"type":"string"},
        "budgetPerPerson":{"type":"string"},
        "reasons":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties": false
    },
    "basicInfo": {
      "type":"object",
      "properties": {
        "address":{"type":"string"},
        "hours":{"type":"string"},
        "lastEntry":{"type":"string"},
        "closure":{"type":"string"},
        "price":{"type":"string"},
        "reservation":{"type":"string"},
        "sameDayTicket":{"type":"string"},
        "payment":{"type":"string"},
        "nearestStation":{"type":"string"},
        "stationWalk":{"type":"string"},
        "officialUrl":{"type":"string","format":"uri"},
        "mapQuery":{"type":"string"}
      },
      "additionalProperties": false
    },
    "durationProfiles": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "required":["label","duration","canDo","basis"],
        "properties": {
          "label":{"type":"string","enum":["超短縮","最低限","標準","じっくり","最大目安"]},
          "duration":{"type":"string"},
          "canDo":{"type":"string"},
          "basis":{"type":"string"},
          "sourceIds":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": false
      }
    },
    "recommendedRoute": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["step","label"],
        "properties": {
          "step":{"type":"integer","minimum":1},
          "label":{"type":"string"},
          "detail":{"type":"string"}
        },
        "additionalProperties": false
      }
    },
    "tips": {
      "type":"array",
      "minItems":5,
      "items": {
        "type":"object",
        "required":["title","detail"],
        "properties": {
          "title":{"type":"string"},
          "detail":{"type":"string"},
          "sourceIds":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": false
      }
    },
    "crowd": {
      "type":"object",
      "properties": {
        "summary":{"type":"string"},
        "periods": {
          "type":"array",
          "items": {
            "type":"object",
            "required":["period","level","note"],
            "properties": {
              "period":{"type":"string"},
              "level":{"type":"string","enum":["LOW","MEDIUM","HIGH","UNKNOWN"]},
              "note":{"type":"string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "partyOfThree": {"type":"array","items":{"type":"string"}},
    "cutRules": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["delay","action"],
        "properties": {
          "delay":{"type":"string"},
          "action":{"type":"string"}
        },
        "additionalProperties": false
      }
    },
    "prep": {"type":"array","items":{"type":"string"}},
    "dayOfChecks": {"type":"array","items":{"type":"string"}},
    "sources": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "required":["id","title","url","type","accessed","confirmed"],
        "properties": {
          "id":{"type":"string"},
          "title":{"type":"string"},
          "url":{"type":"string","format":"uri"},
          "type":{"type":"string","enum":["OFFICIAL","PUBLIC_BODY","TRAVEL_MEDIA","NEWS","BLOG","REVIEW","OTHER"]},
          "published":{"type":["string","null"]},
          "updated":{"type":["string","null"]},
          "accessed":{"type":"string"},
          "confirmed":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
